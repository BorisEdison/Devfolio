---
const {
  title = "Boris Edison",
  description = "Boris Edison is a full-stack developer and open-source contributor, specializing in JavaScript, web development, and modern tech stacks.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <meta name="description" content={description} />

    <meta
      name="keywords"
      content="Boris Edison, software developer, pandevs.org, pandevsorg, pandevs org, rumblesheet.js, rumblesheetjs, rumblesheet js, RumblesheetJS, Rumblesheet.JS,
    full-stack engineer, open-source contributor, JavaScript, TypeScript, web development, frontend, 
    backend, coding, software engineering, programming, tech blog, web apps, modern frameworks, UI/UX"
    />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link
      rel="shortcut icon"
      href="/content/favicon.webp"
      type="image/x-icon"
    />

    <!-- AnimateCSS -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"
    />

    <!-- AOS -->
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet" />

    <!-- Bootstrap cdn-->
    <link
      href="//cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-1BmE4kWBq78iYhFldvKuhfTAU6auU8tT94WrHftjDbrCEXSU1oBoqyl2QvZ6jIW3"
      crossorigin="anonymous"
    />

    <!-- BalloonCSS CDN -->
    <link
      rel="stylesheet"
      href="https://unpkg.com/balloon-css/balloon.min.css"
    />

    <!-- Google font -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css?family=Corinthia&&?family=Ubuntu"
    />

    <!-- Hamburger -->
    <link rel="stylesheet" href="/dist/hamburgers/hamburger.css" />

    <!-- Local StyleSheet -->
    <link rel="stylesheet" href="/css/resume.css" />
    <link rel="stylesheet" href="/css/waves.css" />
    <link rel="stylesheet" href="/css/about.css" />
    <link rel="stylesheet" href="/css/contact.css" />
    <link rel="stylesheet" href="/css/technical.css" />
    <link rel="stylesheet" href="/css/project.css" />
    <link rel="stylesheet" href="/css/home.css" />
    <link rel="stylesheet" href="/css/preloader.css" />
    <link rel="stylesheet" href="/css/navbar.css" />
    <link rel="stylesheet" href="/css/styles.css" />
  </head>

  <body>
    <slot />

    <!-- AOS -->
    <script is:inline src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script is:inline>
      AOS.init();
    </script>

    <!-- Boostrap CDN -->
    <script
      is:inline
      src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.10.2/dist/umd/popper.min.js"
      integrity="sha384-7+zCNj/IqJ95wo16oMtfsKbZ9ccEh31eOz1HGyDuCQ6wgnyJNSYdrPa03rtR1zdB"
      crossorigin="anonymous"></script>
    <script
      is:inline
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.min.js"
      integrity="sha384-QJHtvGhmr9XOIpI6YVutG+2QOK9T+ZnN4kzFN1RtK3zEFEIsxhlmWl5/YESvpZ13"
      crossorigin="anonymous"></script>

    <!-- iconify -->
    <script is:inline src="https://code.iconify.design/2/2.1.2/iconify.min.js"
    ></script>

    <!-- jQuery -->
    <script
      is:inline
      src="//ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script
      is:inline
      src="https://code.jquery.com/jquery-3.2.1.slim.min.js"
      integrity="sha384-KJ3o2DKtIkvYIK3UENzmM7KCkRr/rE9/Qpg6aAZGJwFDMVNA/GpGFF93hXpG5KkN"
      crossorigin="anonymous"></script>

    <!-- Local JavaScript -->
    <script is:inline src="/js/index.js"></script>
    <script is:inline src="/js/rollUp.js"></script>
    <script is:inline src="/js/toggleTheme.js"></script>
  </body>
</html>
