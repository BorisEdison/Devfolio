---
import { EWave } from "../enums/wave.enum";

interface Props {
  variant?: EWave;
}

const { variant = EWave.PRIMARY } = Astro.props;

const fills =
  variant === EWave.SECONDARY
    ? [
        "var(--clr-accent-400)",
        "var(--clr-accent-300)",
        "var(--clr-accent-200)",
        "var(--clr-accent-100)",
      ]
    : [
        "var(--clr-accent-200)",
        "var(--clr-accent-300)",
        "var(--clr-accent-400)",
        "var(--clr-accent-300)",
      ];
---

<div>
  <svg
    class="waves"
    xmlns="http://www.w3.org/2000/svg"
    xmlns:xlink="http://www.w3.org/1999/xlink"
    viewBox="0 24 150 28"
    preserveAspectRatio="none"
    shape-rendering="auto"
  >
    <defs>
      <path
        id="gentle-wave"
        d="M-160 44c30 0 58-18 88-18s 58 18 88 18 58-18 88-18 58 18 88 18 v44h-352z"
      ></path>
    </defs>
    <g class="parallax">
      <use xlink:href="#gentle-wave" x="48" y="0" fill={fills[0]}></use>
      <use xlink:href="#gentle-wave" x="48" y="3" fill={fills[1]}></use>
      <use xlink:href="#gentle-wave" x="48" y="5" fill={fills[2]}></use>
      <use xlink:href="#gentle-wave" x="48" y="7" fill={fills[3]}></use>
    </g>
  </svg>
</div>
